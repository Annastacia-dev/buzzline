# Supabase project (Dashboard → Project Settings → API Keys). Copy to .env.local for local dev,
# and add the same three to Vercel → Project → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Claude API key for "Generate with AI" (console.anthropic.com → API Keys). Server only.
# Without it the rest of the app works; generating a quiz shows a "not set up" message.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: the public address used in canonical links, the sitemap and share images.
# Defaults to Vercel's production URL.
# NEXT_PUBLIC_SITE_URL=https://buzzline.example.com
